{
  "name": "operations-orchestration-api",
  "version": "0.0.0-development",
  "description": "HPE's Operations Orchestration (OO) client API module for NodeJS",
  "main": "./lib/main.js",
  "scripts": {
    "test": "standard && mocha test/test.js",
    "coverage": "node_modules/.bin/istanbul cover ./node_modules/mocha/bin/_mocha --report lcovonly -- -R spec && cat ./coverage/lcov.info | ./node_modules/coveralls/bin/coveralls.js && rm -rf ./coverage",
    "lint": "echo \"No lint step configured\"",
    "build": "echo \"No build step configured\"",
    "lint:markdown": "markdownlint -c .github/.markdownlint.yml -i 'apm_modules/**' -i '.git' -i '__tests__' -i '.github' -i '.changeset' -i 'CODE_OF_CONDUCT.md' -i 'CHANGELOG.md' -i 'docs/**' -i '.superpowers/**' -i 'node_modules' -i 'dist' '**/**.md'",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lirantal/operations-orchestration-api"
  },
  "keywords": [
    "operations",
    "orchestration",
    "oo",
    "operations-orchestration",
    "api",
    "hpe"
  ],
  "author": "Liran Tal <liran.tal@gmail.com> (http://www.enginx.com)",
  "license": "MIT",
  "dependencies": {
    "request": "^2.88.2"
  },
  "devDependencies": {
    "coveralls": "^3.0.0",
    "istanbul": "^0.4.4",
    "mocha": "^11.7.6",
    "mocha-lcov-reporter": "^1.2.0",
    "nock": "^14.0.16",
    "rimraf": "^6.1.3",
    "should": "^13.1.3",
    "standard": "^17.1.2",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "markdownlint-cli": "0.49.0"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.10.0"
  }
}
